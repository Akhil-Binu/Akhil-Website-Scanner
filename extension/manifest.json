{
  "manifest_version": 3,
  "name": "Akhil WebGuard",
  "version": "1.0.0",
  "description": "Instantly see the security score of any website you visit.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://localhost:3000/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
